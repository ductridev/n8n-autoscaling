REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
QUEUE_NAME_PREFIX=bull
QUEUE_NAME=jobs
N8N_WORKER_SERVICE_NAME=n8n-worker
COMPOSE_PROJECT_NAME=n8n-autoscaling
COMPOSE_FILE_PATH=/app/docker-compose.yml
MIN_REPLICAS=1
MAX_REPLICAS=5
SCALE_UP_QUEUE_THRESHOLD=5
SCALE_DOWN_QUEUE_THRESHOLD=1
POLLING_INTERVAL_SECONDS=10
COOLDOWN_PERIOD_SECONDS=10
POSTGRES_HOST=postgres
POSTGRES_DB=n8n
POSTGRES_USER=postgres
POSTGRES_PASSWORD= # YOUR POSTGRES PASSWORD
PGDATA=/var/lib/postgresql/data/pgdata
N8N_DIAGNOSTICS_ENABLED=false
N8N_USER_FOLDER=/n8n/main
N8N_PORT=5678
N8N_SECURE_COOKIE=true
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=false
N8N_ENCRYPTION_KEY= # 32 characters MAKE YOUR OWN KEY
EXECUTIONS_MODE=queue
QUEUE_BULL_REDIS_HOST=redis
QUEUE_HEALTH_CHECK_ACTIVE=true
DB_TYPE=postgresdb
OFFLOAD_MANUAL_EXECUTIONS_TO_WORKERS=true
N8N_TASK_BROKER_URL=http://n8n:5679
N8N_COMMAND_RESPONSE_URL=http://n8n:5679
N8N_TASK_BROKER_PORT=5679
N8N_RUNNERS_AUTH_TOKEN= # MAKE YOUR OWN TOKEN
POLL_INTERVAL_SECONDS=5
NODE_FUNCTION_ALLOW_EXTERNAL=ajv,ajv-formats,puppeteer
PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium
GENERIC_TIMEZONE=Europe/Stockholm
N8N_BASIC_AUTH_ACTIVE=true
EXECUTIONS_DATA_SAVE_ON_SUCCESS=none
EXECUTIONS_DATA_SAVE_ON_ERROR=all
EXECUTIONS_DATA_PRUNE=true
EXECUTIONS_DATA_MAX_AGE=3360
N8N_SKIP_WEBHOOK_DEREGISTRATION_SHUTDOWN=true

# Backup Configuration
BACKUP_KEEP=14
BACKUP_SLEEP_SECONDS=86400

# Optional: Restic Offsite Backup (S3/Backblaze)
RESTIC_ENABLED=false
RESTIC_REPOSITORY= # s3:s3.amazonaws.com/my-bucket/n8n-backups OR b2:bucket-name:n8n-backups
RESTIC_PASSWORD= # Encryption password for restic repository
RESTIC_RETENTION_DAILY=14
RESTIC_RETENTION_WEEKLY=8
RESTIC_RETENTION_MONTHLY=6
RESTIC_RETENTION_YEARLY=2

# S3 Configuration (if using S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# Backblaze B2 Configuration (if using Backblaze)
B2_ACCOUNT_ID=
B2_ACCOUNT_KEY=